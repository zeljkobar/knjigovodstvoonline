{
  "manifest_version": 3,
  "name": "Summa IRMS i CBCG pretraga",
  "version": "1.1.0",
  "description": "Prenosi javno prikazane podatke iz IRMS i CBCG registara u Summa program.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://irms.tax.gov.me/*", "https://eportal.cbcg.me/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://knjigovodstvoonline.me/*",
        "https://www.knjigovodstvoonline.me/*",
        "https://*.summasummarum.me/*"
      ],
      "js": ["summa-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://irms.tax.gov.me/public/search-register*"],
      "js": ["irms-reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://eportal.cbcg.me/cbcgPregledi/faces/pages/pregledracuni.jspx*"],
      "js": ["cbcg-common.js", "cbcg-reader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Summa IRMS i CBCG pretraga" }
}
