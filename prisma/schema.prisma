generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rola {
  admin
  admin_agencije
  korisnik_agencije
  klijent
}

enum TipKomitenta {
  kupac
  dobavljac
  kupac_dobavljac
  radnik
  ostalo
}

enum TipKonta {
  analiticko
  sinteticko
}

enum KomitentScope {
  GLOBAL
  AGENCY
  COMPANY
}

model Agencija {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv         String
  pib           String?             @unique
  adresa        String?
  grad          String?
  telefon       String?
  email         String?
  aktivan       Boolean             @default(true)
  is_deleted    Boolean             @default(false)
  deleted_at    DateTime?
  deleted_by    String?             @db.Uuid
  delete_reason String?
  created_at    DateTime            @default(now())
  created_by    String?             @db.Uuid
  updated_at    DateTime            @updatedAt
  updated_by    String?             @db.Uuid
  firme         Firma[]
  kufBooks      KufBook[]
  kufEntries    KufEntry[]
  kifBooks      KifBook[]
  kifEntries    KifEntry[]
  korisnici     Korisnik[]
  agencijaKonta AgencijaKonto[]
  pdvStope      PdvStopa[]
  auditLogovi   AuditLog[]
  pretplate     AgencijaPretplata[]
  prava         KorisnikPravo[]
  aktivnosti    AktivnostDogadjaj[]

  @@map("agencije")
}

model Korisnik {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnicko_ime      String              @unique
  email               String?             @unique
  lozinka_hash        String
  rola                Rola
  agencija_id         String?             @db.Uuid
  agencija            Agencija?           @relation(fields: [agencija_id], references: [id])
  aktivan             Boolean             @default(true)
  zadnja_prijava_at   DateTime?
  is_deleted          Boolean             @default(false)
  deleted_at          DateTime?
  deleted_by          String?             @db.Uuid
  delete_reason       String?
  created_at          DateTime            @default(now())
  created_by          String?             @db.Uuid
  updated_at          DateTime            @updatedAt
  updated_by          String?             @db.Uuid
  firme               KorisnikFirma[]
  kreirani_nalozi     Nalog[]
  auditLogovi         AuditLog[]
  pozivnice           Pozivnica[]
  prava               KorisnikPravo[]
  aktivnosti          AktivnostDogadjaj[]
  obnovljenePretplate AgencijaPretplata[] @relation("PretplatuObnovio")

  @@map("korisnici")
}

model Pozivnica {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnik_id    String    @db.Uuid
  korisnik       Korisnik  @relation(fields: [korisnik_id], references: [id])
  token_hash     String    @unique
  expires_at     DateTime
  iskorisceno_at DateTime?
  created_at     DateTime  @default(now())

  @@map("pozivnice")
}

model Firma {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id          String                      @db.Uuid
  agencija             Agencija                    @relation(fields: [agencija_id], references: [id])
  naziv                String
  skraceni_naziv       String?
  tip_subjekta         String                      @default("DOO")
  pib                  String?
  maticni_broj         String?
  pdv_broj             String?
  sifra_djelatnosti    String?
  opis_djelatnosti     String?
  datum_registracije   DateTime?                   @db.Date
  pravna_forma         String?
  status_registracije  String?
  status_firme         String                      @default("ACTIVE")
  adresa               String?
  opstina              String?
  grad                 String?
  drzava               String?                     @default("Crna Gora")
  telefon              String?
  email                String?
  web_sajt             String?
  napomena             String?
  pdv_obveznik         Boolean                     @default(false)
  aktivan              Boolean                     @default(true)
  is_deleted           Boolean                     @default(false)
  deleted_at           DateTime?
  deleted_by           String?                     @db.Uuid
  delete_reason        String?
  created_at           DateTime                    @default(now())
  created_by           String?                     @db.Uuid
  updated_at           DateTime                    @updatedAt
  updated_by           String?                     @db.Uuid
  korisnici            KorisnikFirma[]
  poslovne_godine      PoslovnaGodina[]
  komitenti            FirmaKomitent[]
  kufBooks             KufBook[]
  kufEntries           KufEntry[]
  kifBooks             KifBook[]
  kifEntries           KifEntry[]
  racunVrste           RacunVrsta[]
  bankovni_racuni      FirmaBankovniRacun[]
  ugovor               FirmaUgovor?
  konta                FirmaKonto[]
  podrazumijevanaKonta FirmaPodrazumijevanoKonto[]
  nalozi               Nalog[]
  auditLogovi          AuditLog[]
  prava                KorisnikPravo[]
  aktivnosti           AktivnostDogadjaj[]

  @@unique([agencija_id, pib])
  @@map("firme")
}

model FirmaBankovniRacun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id   String    @db.Uuid
  firma_id      String    @db.Uuid
  firma         Firma     @relation(fields: [firma_id], references: [id])
  naziv_banke   String
  broj_racuna   String
  valuta        String    @default("EUR")
  glavni        Boolean   @default(false)
  aktivan       Boolean   @default(true)
  napomena      String?
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?
  deleted_by    String?   @db.Uuid
  delete_reason String?
  created_at    DateTime  @default(now())
  created_by    String?   @db.Uuid
  updated_at    DateTime  @updatedAt
  updated_by    String?   @db.Uuid

  @@unique([firma_id, broj_racuna])
  @@index([agencija_id, firma_id])
  @@map("firma_bankovni_racuni")
}

model FirmaUgovor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id             String    @db.Uuid
  firma_id                String    @unique @db.Uuid
  firma                   Firma     @relation(fields: [firma_id], references: [id])
  datum_pocetka           DateTime? @db.Date
  datum_prestanka         DateTime? @db.Date
  mjesecna_cijena         Decimal?  @db.Decimal(14, 2)
  valuta                  String    @default("EUR")
  rok_placanja_dana       Int?
  dan_fakturisanja        Int?
  paket                   String?
  dodatne_usluge          String?
  dugovanje               Decimal?  @db.Decimal(14, 2)
  blokiran_zbog_duga      Boolean   @default(false)
  automatsko_fakturisanje Boolean   @default(false)
  faktura_kao_nacrt       Boolean   @default(true)
  napomena                String?
  created_at              DateTime  @default(now())
  created_by              String?   @db.Uuid
  updated_at              DateTime  @updatedAt
  updated_by              String?   @db.Uuid

  @@index([agencija_id, firma_id])
  @@map("firma_ugovori")
}

model KorisnikFirma {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnik_id     String    @db.Uuid
  korisnik        Korisnik  @relation(fields: [korisnik_id], references: [id])
  firma_id        String    @db.Uuid
  firma           Firma     @relation(fields: [firma_id], references: [id])
  moze_da_gleda   Boolean   @default(true)
  moze_da_unosi   Boolean   @default(false)
  moze_da_mijenja Boolean   @default(false)
  moze_da_brise   Boolean   @default(false)
  access_type     String?
  glavni_radnik   Boolean   @default(false)
  valid_from      DateTime?
  valid_to        DateTime?
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime?
  deleted_by      String?   @db.Uuid
  delete_reason   String?
  created_at      DateTime  @default(now())
  created_by      String?   @db.Uuid
  updated_at      DateTime  @updatedAt
  updated_by      String?   @db.Uuid

  @@unique([korisnik_id, firma_id])
  @@map("korisnik_firma")
}

model AgencijaPretplata {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id         String    @db.Uuid
  agencija            Agencija  @relation(fields: [agencija_id], references: [id])
  paket               String
  pocinje_at          DateTime  @db.Date
  istice_at           DateTime  @db.Date
  status              String
  max_firmi           Int?
  max_korisnika       Int?
  napomena            String?
  zadnja_obnova_at    DateTime?
  obnovio_korisnik_id String?   @db.Uuid
  obnovio_korisnik    Korisnik? @relation("PretplatuObnovio", fields: [obnovio_korisnik_id], references: [id])
  created_at          DateTime  @default(now())
  created_by          String?   @db.Uuid
  updated_at          DateTime  @updatedAt
  updated_by          String?   @db.Uuid

  @@index([agencija_id, status])
  @@map("agencija_pretplate")
}

model KorisnikPravo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id String   @db.Uuid
  agencija    Agencija @relation(fields: [agencija_id], references: [id])
  korisnik_id String   @db.Uuid
  korisnik    Korisnik @relation(fields: [korisnik_id], references: [id])
  firma_id    String?  @db.Uuid
  firma       Firma?   @relation(fields: [firma_id], references: [id])
  modul       String
  akcija      String
  dozvoljeno  Boolean  @default(true)
  created_at  DateTime @default(now())
  created_by  String?  @db.Uuid
  updated_at  DateTime @updatedAt
  updated_by  String?  @db.Uuid

  @@unique([agencija_id, korisnik_id, firma_id, modul, akcija])
  @@index([korisnik_id, firma_id, modul])
  @@map("korisnik_prava")
}

model AktivnostDogadjaj {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id   String?   @db.Uuid
  agencija      Agencija? @relation(fields: [agencija_id], references: [id])
  firma_id      String?   @db.Uuid
  firma         Firma?    @relation(fields: [firma_id], references: [id])
  korisnik_id   String?   @db.Uuid
  korisnik      Korisnik? @relation(fields: [korisnik_id], references: [id])
  modul         String
  akcija        String
  tip_entiteta  String
  entitet_id    String?   @db.Uuid
  activity_date DateTime  @db.Date
  created_at    DateTime  @default(now())

  @@index([agencija_id, korisnik_id, activity_date])
  @@index([agencija_id, firma_id, activity_date])
  @@index([agencija_id, modul, akcija])
  @@map("aktivnost_dogadjaji")
}

model PoslovnaGodina {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id   String   @db.Uuid
  firma      Firma    @relation(fields: [firma_id], references: [id])
  godina     Int
  datum_od   DateTime @db.Date
  datum_do   DateTime @db.Date
  zakljucena Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  nalozi     Nalog[]
  kufBooks   KufBook[]
  kufEntries KufEntry[]
  kifBooks   KifBook[]
  kifEntries KifEntry[]

  @@unique([firma_id, godina])
  @@map("poslovne_godine")
}

model Komitent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv         String
  scope         KomitentScope       @default(GLOBAL)
  agencija_id   String?             @db.Uuid
  firma_id      String?             @db.Uuid
  pib           String?
  maticni_broj  String?
  pdv_broj      String?
  pravna_forma  String?
  sifra_djelatnosti String?
  datum_registracije DateTime?           @db.Date
  is_foreign    Boolean             @default(false)
  country_code  String?
  country_name  String?
  foreign_tax_number String?
  adresa        String?
  grad          String?
  drzava        String?             @default("Crna Gora")
  telefon       String?
  email         String?
  web_sajt      String?
  aktivan       Boolean             @default(true)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  firme         FirmaKomitent[]
  kontakti      KomitentKontakt[]
  stavke_naloga StavkaNaloga[]
  kufEntries     KufEntry[]
  kifEntries     KifEntry[]
  ziro_racuni   KomitentZiroRacun[]

  @@index([is_foreign])
  @@map("komitenti")
}

model FirmaKomitent {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id          String       @db.Uuid
  firma             Firma        @relation(fields: [firma_id], references: [id])
  komitent_id       String       @db.Uuid
  komitent          Komitent     @relation(fields: [komitent_id], references: [id])
  tip_komitenta     TipKomitenta
  sifra_u_firmi     String?
  rok_placanja_dana Int?
  default_kuf_konto_sifra String?
  default_kuf_pdv_stopa_sifra String?
  napomena          String?
  aktivan           Boolean      @default(true)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  @@unique([firma_id, komitent_id])
  @@map("firma_komitent")
}

model Banka {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv       String
  sifra       String?             @unique
  swift       String?
  aktivan     Boolean             @default(true)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  ziro_racuni KomitentZiroRacun[]

  @@map("banke")
}

model KomitentZiroRacun {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  komitent_id String   @db.Uuid
  komitent    Komitent @relation(fields: [komitent_id], references: [id])
  banka_id    String?  @db.Uuid
  banka       Banka?   @relation(fields: [banka_id], references: [id])
  broj_racuna String
  valuta      String   @default("EUR")
  glavni      Boolean  @default(false)
  aktivan     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([komitent_id, broj_racuna])
  @@map("komitent_ziro_racuni")
}

model KomitentKontakt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  komitent_id String   @db.Uuid
  komitent    Komitent @relation(fields: [komitent_id], references: [id])
  ime         String?
  prezime     String?
  naziv       String?
  pozicija    String?
  telefon     String?
  email       String?
  napomena    String?
  glavni      Boolean  @default(false)
  aktivan     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("komitent_kontakti")
}

model Konto {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sifra                  String          @unique
  naziv                  String
  klasa                  String?
  tip_konta              TipKonta
  analitika_obavezna     Boolean         @default(false)
  sinteticki_konto       String?
  normalni_saldo         String?
  koristi_radnu_jedinicu Boolean         @default(false)
  aktivan                Boolean         @default(true)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  agencijaKonta          AgencijaKonto[]
  firme                  FirmaKonto[]

  @@map("konta")
}

model AgencijaKonto {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id            String       @db.Uuid
  agencija               Agencija     @relation(fields: [agencija_id], references: [id])
  konto_id               String?      @db.Uuid
  konto                  Konto?       @relation(fields: [konto_id], references: [id])
  sifra                  String
  naziv                  String
  tip_konta              TipKonta
  analitika_obavezna     Boolean      @default(false)
  sinteticki_konto       String?
  normalni_saldo         String?
  koristi_radnu_jedinicu Boolean      @default(false)
  aktivan                Boolean      @default(true)
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt
  firme                  FirmaKonto[]

  @@unique([agencija_id, sifra])
  @@map("agencija_konta")
}

model FirmaKonto {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id               String         @db.Uuid
  firma                  Firma          @relation(fields: [firma_id], references: [id])
  konto_id               String?        @db.Uuid
  konto                  Konto?         @relation(fields: [konto_id], references: [id])
  agencija_konto_id      String?        @db.Uuid
  agencija_konto         AgencijaKonto? @relation(fields: [agencija_konto_id], references: [id])
  sifra                  String
  naziv                  String
  tip_konta              TipKonta
  analitika_obavezna     Boolean        @default(false)
  sinteticki_konto       String?
  normalni_saldo         String?
  koristi_radnu_jedinicu Boolean        @default(false)
  override_type          String         @default("CUSTOM")
  napomena               String?
  aktivan                Boolean        @default(true)
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  stavke_naloga          StavkaNaloga[]
  kufExpenseEntries      KufEntry[]     @relation("KufExpenseAccount")
  kifRevenueEntries      KifEntry[]     @relation("KifRevenueAccount")

  @@unique([firma_id, sifra])
  @@map("firma_konta")
}

model FirmaPodrazumijevanoKonto {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id        String   @db.Uuid
  firma           Firma    @relation(fields: [firma_id], references: [id])
  namjena         String
  dokument_tip    String   @default("GENERAL")
  podvrsta        String   @default("GENERAL")
  pdv_stopa_sifra String   @default("GENERAL")
  sifra_konta     String
  smjer           String   @default("D")
  komitent_id     String?  @db.Uuid
  napomena        String?
  created_at      DateTime @default(now())
  created_by      String?  @db.Uuid
  updated_at      DateTime @updatedAt
  updated_by      String?  @db.Uuid

  @@unique([firma_id, namjena, dokument_tip, podvrsta, pdv_stopa_sifra])
  @@map("firma_podrazumijevana_konta")
}

model RacunVrsta {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id        String                    @db.Uuid
  firma_id           String                    @db.Uuid
  firma              Firma                     @relation(fields: [firma_id], references: [id])
  vrsta_naloga_id    String?                   @db.Uuid
  vrsta_naloga       VrstaNaloga?              @relation(fields: [vrsta_naloga_id], references: [id])
  dokument_tip       String
  sifra              String
  naziv              String
  opis               String?
  redosljed          Int                       @default(0)
  sistemska          Boolean                   @default(false)
  aktivna            Boolean                   @default(true)
  created_at         DateTime                  @default(now())
  created_by         String?                   @db.Uuid
  updated_at         DateTime                  @updatedAt
  updated_by         String?                   @db.Uuid
  kufBooks           KufBook[]
  kifBooks           KifBook[]
  kontiranjePravila  RacunKontiranjePravilo[]

  @@unique([firma_id, dokument_tip, sifra])
  @@index([agencija_id, firma_id, dokument_tip, aktivna])
  @@index([vrsta_naloga_id])
  @@map("racun_vrste")
}

model RacunKontiranjePravilo {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  racun_vrsta_id     String     @db.Uuid
  racun_vrsta        RacunVrsta @relation(fields: [racun_vrsta_id], references: [id], onDelete: Cascade)
  polje_sifra        String
  polje_naziv        String
  pdv_stopa_sifra    String?
  smjer              String
  konto_izvor        String     @default("FIXED")
  sifra_konta        String?
  redosljed          Int        @default(0)
  aktivno            Boolean    @default(true)
  created_at         DateTime   @default(now())
  created_by         String?    @db.Uuid
  updated_at         DateTime   @updatedAt
  updated_by         String?    @db.Uuid

  @@unique([racun_vrsta_id, polje_sifra])
  @@index([racun_vrsta_id, redosljed])
  @@map("racun_kontiranje_pravila")
}

model PdvStopa {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id String    @db.Uuid
  agencija    Agencija  @relation(fields: [agencija_id], references: [id])
  sifra       String
  naziv       String
  procenat    Decimal   @db.Decimal(5, 2)
  opis        String?
  redosljed   Int       @default(0)
  aktivna     Boolean   @default(true)
  vazi_od     DateTime? @db.Date
  vazi_do     DateTime? @db.Date
  created_at  DateTime  @default(now())
  created_by  String?   @db.Uuid
  updated_at  DateTime  @updatedAt
  updated_by  String?   @db.Uuid
  kufTaxLines KufEntryTaxLine[]

  @@unique([agencija_id, sifra])
  @@index([agencija_id, aktivna, redosljed])
  @@map("pdv_stope")
}

model KufEntry {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kuf_book_id              String?           @db.Uuid
  kuf_book                 KufBook?          @relation(fields: [kuf_book_id], references: [id])
  agencija_id              String            @db.Uuid
  agencija                 Agencija          @relation(fields: [agencija_id], references: [id])
  firma_id                 String            @db.Uuid
  firma                    Firma             @relation(fields: [firma_id], references: [id])
  poslovna_godina_id       String            @db.Uuid
  poslovna_godina          PoslovnaGodina    @relation(fields: [poslovna_godina_id], references: [id])
  dobavljac_id             String            @db.Uuid
  dobavljac                Komitent          @relation(fields: [dobavljac_id], references: [id])
  redni_broj               Int
  internal_kuf_number      String
  supplier_invoice_number  String
  vat_transaction_type     String            @default("DOMESTIC")
  is_import                Boolean           @default(false)
  customs_declaration_number String?
  customs_declaration_date DateTime?         @db.Date
  goods_value              Decimal           @default(0) @db.Decimal(14, 2)
  customs_base_amount      Decimal           @default(0) @db.Decimal(14, 2)
  customs_duty_amount      Decimal           @default(0) @db.Decimal(14, 2)
  customs_vat_rate_percent Decimal?          @db.Decimal(5, 2)
  customs_vat_amount       Decimal           @default(0) @db.Decimal(14, 2)
  fiscal_iic               String?
