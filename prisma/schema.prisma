generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rola {
  admin
  admin_agencije
  korisnik_agencije
  klijent
}

enum TipKomitenta {
  kupac
  dobavljac
  kupac_dobavljac
  radnik
  ostalo
}

enum TipKonta {
  analiticko
  sinteticko
}

enum KomitentScope {
  GLOBAL
  AGENCY
  COMPANY
}

model Agencija {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv          String
  pib            String?              @unique
  adresa         String?
  grad           String?
  telefon        String?
  email          String?
  aktivan        Boolean              @default(true)
  is_fiscal_direct_container Boolean  @default(false)
  is_deleted     Boolean              @default(false)
  deleted_at     DateTime?
  deleted_by     String?              @db.Uuid
  delete_reason  String?
  created_at     DateTime             @default(now())
  created_by     String?              @db.Uuid
  updated_at     DateTime             @updatedAt
  updated_by     String?              @db.Uuid
  firme          Firma[]
  kufBooks       KufBook[]
  kufEntries     KufEntry[]
  kifBooks       KifBook[]
  kifEntries     KifEntry[]
  fiskalniIzlazniRacuni FiskalniIzlazniRacun[]
  pdvPeriodi     PdvPeriod[]
  pdvPrijave     PdvPrijava[]
  pdvPodesavanja PdvPodesavanja[]
  korisnici      Korisnik[]
  agencijaKonta  AgencijaKonto[]
  pdvStope       PdvStopa[]
  grupeArtikala  GrupaArtikla[]
  artikli        Artikal[]
  cijeneArtikala CijenaArtikla[]
  magacini       Magacin[]
  kalkulacije    Kalkulacija[]
  dobavljacArtikalVeze DobavljacArtikalVeza[]
  stanjaZaliha   StanjeZaliha[]
  prometiZaliha  PrometZaliha[]
  auditLogovi    AuditLog[]
  pretplate      AgencijaPretplata[]
  prava          KorisnikPravo[]
  aktivnosti     AktivnostDogadjaj[]
  odgovornaLica  FirmaOdgovornoLice[]
  fiscalCompanyLinks FiscalCompanyLink[]

  @@map("agencije")
}

model Korisnik {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnicko_ime      String              @unique
  email               String?             @unique
  lozinka_hash        String
  rola                Rola
  agencija_id         String?             @db.Uuid
  agencija            Agencija?           @relation(fields: [agencija_id], references: [id])
  aktivan             Boolean             @default(true)
  zadnja_prijava_at   DateTime?
  is_deleted          Boolean             @default(false)
  deleted_at          DateTime?
  deleted_by          String?             @db.Uuid
  delete_reason       String?
  created_at          DateTime            @default(now())
  created_by          String?             @db.Uuid
  updated_at          DateTime            @updatedAt
  updated_by          String?             @db.Uuid
  firme               KorisnikFirma[]
  kreirani_nalozi     Nalog[]
  auditLogovi         AuditLog[]
  pozivnice           Pozivnica[]
  prava               KorisnikPravo[]
  aktivnosti          AktivnostDogadjaj[]
  obnovljenePretplate AgencijaPretplata[] @relation("PretplatuObnovio")

  @@map("korisnici")
}

model Pozivnica {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnik_id    String    @db.Uuid
  korisnik       Korisnik  @relation(fields: [korisnik_id], references: [id])
  token_hash     String    @unique
  expires_at     DateTime
  iskorisceno_at DateTime?
  created_at     DateTime  @default(now())

  @@map("pozivnice")
}

model Firma {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id                   String                          @db.Uuid
  agencija                      Agencija                        @relation(fields: [agencija_id], references: [id])
  naziv                         String
  skraceni_naziv                String?
  tip_subjekta                  String                          @default("DOO")
  pib                           String?
  maticni_broj                  String?
  pdv_broj                      String?
  sifra_djelatnosti             String?
  opis_djelatnosti              String?
  datum_registracije            DateTime?                       @db.Date
  pravna_forma                  String?
  status_registracije           String?
  status_firme                  String                          @default("ACTIVE")
  adresa                        String?
  opstina                       String?
  grad                          String?
  drzava                        String?                         @default("Crna Gora")
  telefon                       String?
  email                         String?
  web_sajt                      String?
  napomena                      String?
  pdv_obveznik                  Boolean                         @default(false)
  dozvoli_negativan_lager       Boolean                         @default(false)
  aktivan                       Boolean                         @default(true)
  is_deleted                    Boolean                         @default(false)
  deleted_at                    DateTime?
  deleted_by                    String?                         @db.Uuid
  delete_reason                 String?
  created_at                    DateTime                        @default(now())
  created_by                    String?                         @db.Uuid
  updated_at                    DateTime                        @updatedAt
  updated_by                    String?                         @db.Uuid
  korisnici                     KorisnikFirma[]
  poslovne_godine               PoslovnaGodina[]
  komitenti                     FirmaKomitent[]
  kufBooks                      KufBook[]
  kufEntries                    KufEntry[]
  kifBooks                      KifBook[]
  kifEntries                    KifEntry[]
  fiskalniIzlazniRacuni         FiskalniIzlazniRacun[]
  pdvPeriodi                    PdvPeriod[]
  pdvPrijave                    PdvPrijava[]
  pdvPodesavanja                PdvPodesavanja[]
  racunVrste                    RacunVrsta[]
  bankovni_racuni               FirmaBankovniRacun[]
  bankStatements                BankStatement[]
  partnerBankAccounts           PartnerBankAccount[]
  bankStatementSettings         BankStatementAccountSetting[]
  bankPostingRules              BankPostingRule[]
  finansijskiIzvjestajKorekcije FinansijskiIzvjestajKorekcija[]
  finansijskiIzvjestajArhive    FinansijskiIzvjestajArhiva[]
  ugovor                        FirmaUgovor?
  konta                         FirmaKonto[]
  podrazumijevanaKonta          FirmaPodrazumijevanoKonto[]
  nalozi                        Nalog[]
  auditLogovi                   AuditLog[]
  prava                         KorisnikPravo[]
  aktivnosti                    AktivnostDogadjaj[]
  plateM4Podesavanja            PlateM4Podesavanje[]
  plateM4Uplate                 PlateM4MjesecnaUplata[]
  plateKontiranja               PlateKontiranjePodesavanje[]
  odgovorna_lica                FirmaOdgovornoLice[]
  grupeArtikala                 GrupaArtikla[]
  artikli                       Artikal[]
  cijeneArtikala                CijenaArtikla[]
  magacini                      Magacin[]
  kalkulacije                   Kalkulacija[]
  dobavljacArtikalVeze          DobavljacArtikalVeza[]
  stanjaZaliha                  StanjeZaliha[]
  prometiZaliha                 PrometZaliha[]
  fiscalCompanyLink             FiscalCompanyLink?

  @@unique([agencija_id, pib])
  @@map("firme")
}

model FiscalCompanyLink {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id              String    @db.Uuid
  agencija                 Agencija  @relation(fields: [agencija_id], references: [id])
  firma_id                 String    @unique @db.Uuid
  firma                    Firma     @relation(fields: [firma_id], references: [id])
  fiscal_api_company_id    String?   @unique @db.Uuid
  onboarding_status        String    @default("NOT_CONFIGURED")
  fiscal_environment       String?
  is_suspended             Boolean   @default(false)
  suspension_reason        String?
  suspended_at             DateTime?
  suspended_by             String?   @db.Uuid
  last_readiness_check_at  DateTime?
  last_readiness_result    Json?
  last_correlation_id      String?
  created_at               DateTime  @default(now())
  created_by               String?   @db.Uuid
  updated_at               DateTime  @updatedAt
  updated_by               String?   @db.Uuid

  @@index([agencija_id, onboarding_status])
  @@index([is_suspended])
  @@map("fiscal_company_links")
}

model FirmaOdgovornoLice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id   String    @db.Uuid
  agencija      Agencija  @relation(fields: [agencija_id], references: [id])
  firma_id      String    @db.Uuid
  firma         Firma     @relation(fields: [firma_id], references: [id])
  ime_prezime   String
  jmbg          String?
  uloga         String
  email         String?
  telefon       String?
  primarno      Boolean   @default(false)
  aktivan       Boolean   @default(true)
  napomena      String?
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime?
  deleted_by    String?   @db.Uuid
  delete_reason String?
  created_at    DateTime  @default(now())
  created_by    String?   @db.Uuid
  updated_at    DateTime  @updatedAt
  updated_by    String?   @db.Uuid

  @@index([agencija_id, firma_id, uloga, aktivan, is_deleted])
  @@map("firma_odgovorna_lica")
}

model FirmaBankovniRacun {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id           String                        @db.Uuid
  firma_id              String                        @db.Uuid
  firma                 Firma                         @relation(fields: [firma_id], references: [id])
  naziv_banke           String
  broj_racuna           String
  valuta                String                        @default("EUR")
  glavni                Boolean                       @default(false)
  aktivan               Boolean                       @default(true)
  napomena              String?
  is_deleted            Boolean                       @default(false)
  deleted_at            DateTime?
  deleted_by            String?                       @db.Uuid
  delete_reason         String?
  created_at            DateTime                      @default(now())
  created_by            String?                       @db.Uuid
  updated_at            DateTime                      @updatedAt
  updated_by            String?                       @db.Uuid
  bankStatements        BankStatement[]
  bankStatementSettings BankStatementAccountSetting[]

  @@unique([firma_id, broj_racuna])
  @@index([agencija_id, firma_id])
  @@map("firma_bankovni_racuni")
}

model FirmaUgovor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id             String    @db.Uuid
  firma_id                String    @unique @db.Uuid
  firma                   Firma     @relation(fields: [firma_id], references: [id])
  datum_pocetka           DateTime? @db.Date
  datum_prestanka         DateTime? @db.Date
  mjesecna_cijena         Decimal?  @db.Decimal(14, 2)
  valuta                  String    @default("EUR")
  rok_placanja_dana       Int?
  dan_fakturisanja        Int?
  paket                   String?
  dodatne_usluge          String?
  dugovanje               Decimal?  @db.Decimal(14, 2)
  blokiran_zbog_duga      Boolean   @default(false)
  automatsko_fakturisanje Boolean   @default(false)
  faktura_kao_nacrt       Boolean   @default(true)
  napomena                String?
  created_at              DateTime  @default(now())
  created_by              String?   @db.Uuid
  updated_at              DateTime  @updatedAt
  updated_by              String?   @db.Uuid

  @@index([agencija_id, firma_id])
  @@map("firma_ugovori")
}

model KorisnikFirma {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  korisnik_id     String    @db.Uuid
  korisnik        Korisnik  @relation(fields: [korisnik_id], references: [id])
  firma_id        String    @db.Uuid
  firma           Firma     @relation(fields: [firma_id], references: [id])
  moze_da_gleda   Boolean   @default(true)
  moze_da_unosi   Boolean   @default(false)
  moze_da_mijenja Boolean   @default(false)
  moze_da_brise   Boolean   @default(false)
  access_type     String?
  glavni_radnik   Boolean   @default(false)
  valid_from      DateTime?
  valid_to        DateTime?
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime?
  deleted_by      String?   @db.Uuid
  delete_reason   String?
  created_at      DateTime  @default(now())
  created_by      String?   @db.Uuid
  updated_at      DateTime  @updatedAt
  updated_by      String?   @db.Uuid

  @@unique([korisnik_id, firma_id])
  @@map("korisnik_firma")
}

model AgencijaPretplata {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id         String    @db.Uuid
  agencija            Agencija  @relation(fields: [agencija_id], references: [id])
  paket               String
  pocinje_at          DateTime  @db.Date
  istice_at           DateTime  @db.Date
  status              String
  max_firmi           Int?
  max_korisnika       Int?
  napomena            String?
  zadnja_obnova_at    DateTime?
  obnovio_korisnik_id String?   @db.Uuid
  obnovio_korisnik    Korisnik? @relation("PretplatuObnovio", fields: [obnovio_korisnik_id], references: [id])
  created_at          DateTime  @default(now())
  created_by          String?   @db.Uuid
  updated_at          DateTime  @updatedAt
  updated_by          String?   @db.Uuid

  @@index([agencija_id, status])
  @@map("agencija_pretplate")
}

model KorisnikPravo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id String   @db.Uuid
  agencija    Agencija @relation(fields: [agencija_id], references: [id])
  korisnik_id String   @db.Uuid
  korisnik    Korisnik @relation(fields: [korisnik_id], references: [id])
  firma_id    String?  @db.Uuid
  firma       Firma?   @relation(fields: [firma_id], references: [id])
  modul       String
  akcija      String
  dozvoljeno  Boolean  @default(true)
  created_at  DateTime @default(now())
  created_by  String?  @db.Uuid
  updated_at  DateTime @updatedAt
  updated_by  String?  @db.Uuid

  @@unique([agencija_id, korisnik_id, firma_id, modul, akcija])
  @@index([korisnik_id, firma_id, modul])
  @@map("korisnik_prava")
}

model AktivnostDogadjaj {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id   String?   @db.Uuid
  agencija      Agencija? @relation(fields: [agencija_id], references: [id])
  firma_id      String?   @db.Uuid
  firma         Firma?    @relation(fields: [firma_id], references: [id])
  korisnik_id   String?   @db.Uuid
  korisnik      Korisnik? @relation(fields: [korisnik_id], references: [id])
  modul         String
  akcija        String
  tip_entiteta  String
  entitet_id    String?   @db.Uuid
  activity_date DateTime  @db.Date
  created_at    DateTime  @default(now())

  @@index([agencija_id, korisnik_id, activity_date])
  @@index([agencija_id, firma_id, activity_date])
  @@index([agencija_id, modul, akcija])
  @@map("aktivnost_dogadjaji")
}

model PoslovnaGodina {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id                      String                          @db.Uuid
  firma                         Firma                           @relation(fields: [firma_id], references: [id])
  godina                        Int
  datum_od                      DateTime                        @db.Date
  datum_do                      DateTime                        @db.Date
  zakljucena                    Boolean                         @default(false)
  created_at                    DateTime                        @default(now())
  updated_at                    DateTime                        @updatedAt
  nalozi                        Nalog[]
  kufBooks                      KufBook[]
  kufEntries                    KufEntry[]
  kifBooks                      KifBook[]
  kifEntries                    KifEntry[]
  fiskalniIzlazniRacuni         FiskalniIzlazniRacun[]
  pdvPeriodi                    PdvPeriod[]
  pdvPrijave                    PdvPrijava[]
  pdvPodesavanja                PdvPodesavanja[]
  bankStatements                BankStatement[]
  finansijskiIzvjestajKorekcije FinansijskiIzvjestajKorekcija[]
  finansijskiIzvjestajArhive    FinansijskiIzvjestajArhiva[]
  plateM4Podesavanja            PlateM4Podesavanje[]
  plateM4Uplate                 PlateM4MjesecnaUplata[]
  plateKontiranja               PlateKontiranjePodesavanje[]
  kalkulacije                   Kalkulacija[]
  stanjaZaliha                  StanjeZaliha[]
  prometiZaliha                 PrometZaliha[]

  @@unique([firma_id, godina])
  @@map("poslovne_godine")
}

model Komitent {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv                 String
  scope                 KomitentScope        @default(GLOBAL)
  agencija_id           String?              @db.Uuid
  firma_id              String?              @db.Uuid
  pib                   String?
  maticni_broj          String?
  pdv_broj              String?
  pravna_forma          String?
  sifra_djelatnosti     String?
  datum_registracije    DateTime?            @db.Date
  is_foreign            Boolean              @default(false)
  country_code          String?
  country_name          String?
  foreign_tax_number    String?
  adresa                String?
  grad                  String?
  drzava                String?              @default("Crna Gora")
  telefon               String?
  email                 String?
  web_sajt              String?
  aktivan               Boolean              @default(true)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  firme                 FirmaKomitent[]
  kontakti              KomitentKontakt[]
  stavke_naloga         StavkaNaloga[]
  kufEntries            KufEntry[]
  kifEntries            KifEntry[]
  fiskalniIzlazniRacuni FiskalniIzlazniRacun[]
  ziro_racuni           KomitentZiroRacun[]
  bank_statement_lines  BankStatementLine[]
  partner_bank_accounts PartnerBankAccount[]
  bank_posting_rules    BankPostingRule[]
  cijene_artikala       CijenaArtikla[]
  kalkulacije           Kalkulacija[]
  dobavljacArtikalVeze  DobavljacArtikalVeza[]

  @@index([is_foreign])
  @@index([pib])
  @@index([scope])
  @@map("komitenti")
}

model FirmaKomitent {
  id                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id                    String       @db.Uuid
  firma                       Firma        @relation(fields: [firma_id], references: [id])
  komitent_id                 String       @db.Uuid
  komitent                    Komitent     @relation(fields: [komitent_id], references: [id])
  tip_komitenta               TipKomitenta
  sifra_u_firmi               String?
  rok_placanja_dana           Int?
  default_kuf_konto_sifra     String?
  default_kuf_pdv_stopa_sifra String?
  napomena                    String?
  aktivan                     Boolean      @default(true)
  created_at                  DateTime     @default(now())
  updated_at                  DateTime     @updatedAt

  @@unique([firma_id, komitent_id])
  @@map("firma_komitent")
}

model Banka {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  naziv       String
  sifra       String?             @unique
  swift       String?
  aktivan     Boolean             @default(true)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  ziro_racuni KomitentZiroRacun[]

  @@map("banke")
}

model KomitentZiroRacun {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  komitent_id String   @db.Uuid
  komitent    Komitent @relation(fields: [komitent_id], references: [id])
  banka_id    String?  @db.Uuid
  banka       Banka?   @relation(fields: [banka_id], references: [id])
  broj_racuna String
  valuta      String   @default("EUR")
  glavni      Boolean  @default(false)
  aktivan     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([komitent_id, broj_racuna])
  @@map("komitent_ziro_racuni")
}

model KomitentKontakt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  komitent_id String   @db.Uuid
  komitent    Komitent @relation(fields: [komitent_id], references: [id])
  ime         String?
  prezime     String?
  naziv       String?
  pozicija    String?
  telefon     String?
  email       String?
  napomena    String?
  glavni      Boolean  @default(false)
  aktivan     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("komitent_kontakti")
}

model Konto {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sifra                  String          @unique
  naziv                  String
  klasa                  String?
  tip_konta              TipKonta
  analitika_obavezna     Boolean         @default(false)
  sinteticki_konto       String?
  normalni_saldo         String?
  koristi_radnu_jedinicu Boolean         @default(false)
  aktivan                Boolean         @default(true)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  agencijaKonta          AgencijaKonto[]
  firme                  FirmaKonto[]

  @@map("konta")
}

model AgencijaKonto {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencija_id            String       @db.Uuid
  agencija               Agencija     @relation(fields: [agencija_id], references: [id])
  konto_id               String?      @db.Uuid
  konto                  Konto?       @relation(fields: [konto_id], references: [id])
  sifra                  String
  naziv                  String
  tip_konta              TipKonta
  analitika_obavezna     Boolean      @default(false)
  sinteticki_konto       String?
  normalni_saldo         String?
  koristi_radnu_jedinicu Boolean      @default(false)
  aktivan                Boolean      @default(true)
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt
  firme                  FirmaKonto[]

  @@unique([agencija_id, sifra])
  @@map("agencija_konta")
}

model FirmaKonto {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firma_id                  String                        @db.Uuid
  firma                     Firma                         @relation(fields: [firma_id], references: [id])
  konto_id                  String?                       @db.Uuid
  konto                     Konto?                        @relation(fields: [konto_id], references: [id])
  agencija_konto_id         String?                       @db.Uuid
  agencija_konto            AgencijaKonto?                @relation(fields: [agencija_konto_id], references: [id])
  sifra                     String
  naziv                     String
  tip_konta                 TipKonta
  analitika_obavezna        Boolean                       @default(false)
  sinteticki_konto          String?
  normalni_saldo            String?
  koristi_radnu_jedinicu    Boolean                       @default(false)
  override_type             String                        @default("CUSTOM")
  napomena                  String?
  aktivan                   Boolean                       @default(true)
  created_at                DateTime                      @default(now())
  updated_at                DateTime                      @updatedAt
  stavke_naloga             StavkaNaloga[]
  kufExpenseEntries         KufEntry[]                    @relation("KufExpenseAccount")
  kifRevenueEntries         KifEntry[]                    @relation("KifRevenueAccount")
  pdvIzlaznaPodesavanja     PdvPodesavanja[]              @relation("PdvIzlazniKonto")
