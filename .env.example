# Lokalna PostgreSQL baza na razvojnom racunaru.
DATABASE_URL="postgresql://postgres:LOKALNA_POSTGRES_LOZINKA@127.0.0.1:5432/knjigovodstvoonline"

# Server PostgreSQL baza preko SSH tunela.
