# Tajna za potpisivanje session cookie-ja.
SESSION_SECRET="PROMIJENI_OVO_U_DUGACAK_RANDOM_STRING"

# Javni URL aplikacije, koristi se za linkove u email pozivnicama.
APP_URL="http://localhost:3000"
# Produkcija: APP_URL="https://knjigovodstvo.summasummarum.me"

# SMTP podesavanja za slanje email pozivnica.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="EMAIL_NALOG"
SMTP_PASS="EMAIL_APP_PASSWORD"
SMTP_FROM="Summa Summarum <EMAIL_NALOG>"

