# Lokalna PostgreSQL baza na razvojnom racunaru.
DATABASE_URL="postgresql://postgres:LOKALNA_POSTGRES_LOZINKA@127.0.0.1:5432/knjigovodstvoonline"

# Server PostgreSQL baza preko SSH tunela.
# Prvo pokrenuti tunel iz tunel.md, pa aktivirati ovu vrijednost.
# DATABASE_URL="postgresql://zeljko:SERVER_POSTGRES_LOZINKA@127.0.0.1:5433/knjigovodstvoonline"

# Tajna za potpisivanje session cookie-ja.
SESSION_SECRET="PROMIJENI_OVO_U_DUGACAK_RANDOM_STRING"

# Javni URL aplikacije, koristi se za linkove u email pozivnicama.
APP_URL="http://localhost:3000"
# Produkcija: APP_URL="https://knjigovodstvo.summasummarum.me"

# SMTP podesavanja za centralno slanje sa admin@summasummarum.me.
# SMTP nalog mora imati dozvolu da salje kao ta adresa.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="EMAIL_NALOG"
SMTP_PASS="EMAIL_APP_PASSWORD"

# IMAP test veze za izvode; samo admin povezane agencije, bez preuzimanja poruka.
# Lozinku unijeti iskljucivo u lokalni/serverski .env.
IMAP_AGENCY_ID=""
IMAP_HOST="imap.example.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="IMAP_KORISNIK"
IMAP_PASS=""
IMAP_FOLDER="INBOX"

# Stara MySQL baza (import globalnih partnera)
OLD_MYSQL_HOST="185.102.78.178"
OLD_MYSQL_PORT="3306"
OLD_MYSQL_USER=""
OLD_MYSQL_PASSWORD=""
OLD_MYSQL_DATABASE="summasum_"
