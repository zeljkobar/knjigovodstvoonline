[Unit]
Description=Administrator requested deployment of an approved site
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/summa-deploy-control run
WorkingDirectory=/var/www/knjigovodstvoonline
TimeoutStartSec=3h
Restart=no
KillMode=control-group
PrivateTmp=false
NoNewPrivileges=true
ProtectSystem=full
